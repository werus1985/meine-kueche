# Supabase (Projekt → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://<projekt>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Öffentliche Basis-URL der App (Einladungs- und Bestätigungslinks)
NEXT_PUBLIC_SITE_URL=https://<domain>

# Verschlüsselung der gespeicherten Gemini-Keys (32 Byte, Base64)
# Erzeugen mit: openssl rand -base64 32
AI_KEYS_SECRET=

# Nur für die Kontolöschung nötig – ausschließlich serverseitig!
SUPABASE_SERVICE_ROLE_KEY=
