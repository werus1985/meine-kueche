# Supabase (Projekt → Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://<projekt>.supabase.co
# Neuer Publishable-Key (sb_publishable_…) oder Legacy-anon-Key
NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable-oder-anon-key>

# Öffentliche Basis-URL der App (Einladungs- und Bestätigungslinks)
NEXT_PUBLIC_SITE_URL=https://<domain>

# Verschlüsselung der gespeicherten Gemini-Keys (32 Byte, Base64)
# Erzeugen mit: openssl rand -base64 32
AI_KEYS_SECRET=

# Nur serverseitig (Kontolöschung, Health-Check):
# neuer Secret-Key (sb_secret_…) oder Legacy-service_role-Key
SUPABASE_SERVICE_ROLE_KEY=
